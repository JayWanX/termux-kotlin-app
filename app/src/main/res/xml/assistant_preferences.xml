<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/assistant_category_general">

        <SwitchPreferenceCompat
            app:key="assistant_enabled"
            app:title="@string/assistant_enabled_title"
            app:summary="@string/assistant_enabled_summary"
            app:defaultValue="false" />

        <ListPreference
            app:key="assistant_preset"
            app:title="@string/assistant_preset_title"
            app:summary="@string/assistant_preset_summary"
            app:useSimpleSummaryProvider="false" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/assistant_category_endpoint">

        <EditTextPreference
            app:key="assistant_api_url"
            app:title="@string/assistant_api_url_title"
            app:summary="@string/assistant_api_url_empty"
            app:dialogTitle="@string/assistant_api_url_title"
            app:useSimpleSummaryProvider="false" />

        <EditTextPreference
            app:key="assistant_api_key"
            app:title="@string/assistant_api_key_title"
            app:summary="@string/assistant_api_key_empty"
            app:dialogTitle="@string/assistant_api_key_title"
            app:useSimpleSummaryProvider="false" />

        <EditTextPreference
            app:key="assistant_model"
            app:title="@string/assistant_model_title"
            app:summary="@string/assistant_model_empty"
            app:dialogTitle="@string/assistant_model_title"
            app:useSimpleSummaryProvider="false" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/assistant_category_behaviour">

        <EditTextPreference
            app:key="assistant_max_rounds"
            app:title="@string/assistant_max_rounds_title"
            app:summary="@string/assistant_max_rounds_summary"
            app:dialogTitle="@string/assistant_max_rounds_title"
            app:useSimpleSummaryProvider="false" />

        <SwitchPreferenceCompat
            app:key="assistant_confirm_commands"
            app:title="@string/assistant_confirm_title"
            app:summary="@string/assistant_confirm_summary"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="assistant_confirm_file_edits"
            app:title="@string/assistant_confirm_edits_title"
            app:summary="@string/assistant_confirm_edits_summary"
            app:defaultValue="true" />

    </PreferenceCategory>

</PreferenceScreen>
