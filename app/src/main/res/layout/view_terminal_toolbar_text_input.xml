<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <EditText
        android:id="@+id/terminal_toolbar_text_input"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:minHeight="40dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/bg_terminal_toolbar_text_input"
        android:imeOptions="flagNoEnterAction|flagNoFullscreen"
        android:inputType="textMultiLine|textNoSuggestions"
        android:importantForAutofill="no"
        android:gravity="top|start"
        android:maxLines="5"
        android:minLines="1"
        android:scrollbars="vertical"
        android:singleLine="false"
        android:breakStrategy="simple"
        android:hyphenationFrequency="none"
        android:overScrollMode="never"
        android:textColor="@android:color/white"
        android:textColorHint="#66FFFFFF"
        android:textColorHighlight="#4D2DD4BF"
        android:textSize="14sp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:hint="@string/terminal_toolbar_text_input_hint"
        android:textCursorDrawable="@null"
        tools:ignore="LabelFor,RtlSymmetry" />

    <ImageButton
        android:id="@+id/terminal_toolbar_text_input_send"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:layout_gravity="center_vertical"
        android:padding="10dp"
        android:background="@drawable/bg_terminal_toolbar_send"
        android:src="@drawable/ic_send"
        android:contentDescription="@string/terminal_toolbar_text_input_send"
        android:tint="@android:color/black" />

</LinearLayout>
