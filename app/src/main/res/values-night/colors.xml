<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Session list on a dark dialog. The light-theme values from values/colors.xml are too dark to read
      here; these are lightened while keeping the same hue relationships, so "running" still reads as
      green and "exited" as red without either turning into neon.
    -->
    <color name="status_muted">#FF8A929B</color>
    <color name="status_accent">#FF2DD4BF</color>
    <color name="status_running">#FF4ADE80</color>
    <color name="status_exited">#FFF87171</color>
    <color name="status_row_current">#FF1F2A2A</color>
</resources>
